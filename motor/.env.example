# Copiar a .env. Nunca poner llaves en argumentos de la CLI.
APIFY_TOKEN=
GROQ_API_KEY=
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
MOTOR_HTTP_TOKEN=
APIFY_ACTOR_RELACIONES=scraping_solutions/instagram-scraper-followers-following-no-cookies
APIFY_ACTOR_PERFILES=apify/instagram-profile-scraper
APIFY_ACTOR_REELS=apify/instagram-reel-scraper
LLM_PROVEEDOR=jev
# groq (servicio final), local (Whisper en esta máquina, solo pruebas) o ninguno (probar Apify + Jev con --reels 0).
TRANSCRIPCION_PROVEEDOR=groq
# Modelo de Whisper local: large-v3-turbo (igual al de Groq), small o base para ir más rápido.
WHISPER_LOCAL_MODELO=large-v3-turbo
TYPESAFE_MODELO=jev-latest
OPENROUTER_MODELO=
# Promedio para comparar con Modash; mediana conserva la fórmula anterior.
METRICAS_AGREGACION=promedio
# Pausa por paso solo en ejecuciones simuladas; 0 no agrega demora.
MOTOR_SIMULADO_RETRASO_S=0
# Perfiles que se analizan a la vez (audio, seguidores y Jev); 1 = en serie.
MOTOR_PARALELO=4
# Solicitudes por minuto de transcripción que permite tu plan de Groq (console.groq.com/settings/limits).
GROQ_RPM=20
